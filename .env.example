# PostgreSQL (Supabase transaction pooler, used by the app at runtime)
DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct / session connection, used by Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Upstash Redis (cart + rate limiting)
UPSTASH_REDIS_REST_URL="https://[INSTANCE].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[TOKEN]"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="[RANDOM_32+_CHAR_SECRET]"
# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Socket.IO server (npm run socket)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
SOCKET_PORT=3001
SOCKET_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Recommendations: "gemini" (built in) or "service" (crave-buddy-recommendation FastAPI)
RECOMMENDER_PROVIDER="gemini"
# Required when RECOMMENDER_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY="[GEMINI_API_KEY]"
# Required when RECOMMENDER_PROVIDER=service
RECOMMENDER_URL="http://localhost:8000"
RECOMMENDER_API_KEY=""
